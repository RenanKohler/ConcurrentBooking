<Window x:Class="ConcurrentBooking.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Loaded="MainWindow_OnLoaded"
        Title="Clinical Booking Client" Height="860" Width="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Clinical Booking Client" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock VerticalAlignment="Center" Width="120" Text="API Base URL"/>
                <TextBox x:Name="ApiBaseUrlTextBox" Width="360" Text="http://localhost:5000/"/>
            </StackPanel>

            <GroupBox Header="Busca clinica" Margin="0,0,0,16">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Especialidade"/>
                    <ComboBox x:Name="SpecialtyComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" DisplayMemberPath="Name"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Unidade"/>
                    <ComboBox x:Name="UnitComboBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" DisplayMemberPath="Name"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Data"/>
                    <DatePicker x:Name="AvailabilityDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Periodo"/>
                    <ComboBox x:Name="PeriodComboBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                        <Button x:Name="SearchProfessionalsButton"
                                Width="180"
                                Margin="0,0,12,0"
                                Content="Buscar profissionais"
                                Click="SearchProfessionalsButton_OnClick"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Profissionais" Margin="0,0,0,16">
                <DataGrid x:Name="ProfessionalsDataGrid"
                          Height="220"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="ProfessionalsDataGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Profissional" Binding="{Binding ProfessionalName}" Width="2*"/>
                        <DataGridTextColumn Header="Especialidade" Binding="{Binding SpecialtyName}" Width="2*"/>
                        <DataGridTextColumn Header="Unidade" Binding="{Binding ClinicUnitName}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Horarios disponiveis" Margin="0,0,0,16">
                <DataGrid x:Name="AvailabilityDataGrid"
                          Height="220"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="AvailabilityDataGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SlotId" Binding="{Binding SlotId}" Width="2*"/>
                        <DataGridTextColumn Header="Inicio" Binding="{Binding StartsAt}" Width="*"/>
                        <DataGridTextColumn Header="Fim" Binding="{Binding EndsAt}" Width="*"/>
                        <DataGridTextColumn Header="Sala" Binding="{Binding SeatCode}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Reserva / Confirmacao">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="SlotId"/>
                    <TextBox x:Name="SlotIdTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="HoldId"/>
                    <TextBox x:Name="HoldIdTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="CustomerId"/>
                    <TextBox x:Name="CustomerIdTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Idempotency Key"/>
                    <TextBox x:Name="IdempotencyKeyTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,8">
                        <Button x:Name="CreateHoldButton" Width="180" Margin="0,0,12,0" Content="Criar Hold" Click="CreateHoldButton_OnClick"/>
                        <Button x:Name="ConfirmHoldButton" Width="180" Content="Confirmar Hold" Click="ConfirmHoldButton_OnClick"/>
                    </StackPanel>

                    <TextBox Grid.Row="5"
                             Grid.ColumnSpan="2"
                             x:Name="ResultTextBox"
                             Height="140"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
